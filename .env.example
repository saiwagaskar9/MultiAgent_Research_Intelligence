# Multi-Agent Research Intelligence Platform
# Environment Configuration

# Fast Option (Recommended): Groq API Key (Free from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Option: Google Gemini API Key (From https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# Active Provider: groq or gemini
LLM_PROVIDER=groq

# Optional: LLM parameters
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3

# Optional: Research parameters
# MAX_REVIEW_ITERATIONS=3
# QUALITY_THRESHOLD=75
# MAX_SEARCH_RESULTS=6
# OUTPUTS_DIR=outputs
